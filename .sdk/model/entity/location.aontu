                r: false
                t: "`$ANY`"
              }
              {
                k: "query"
                n: "y"
                or: "y"
                r: false
                t: "`$ANY`"
              }
            ]
          }
          m: "GET"
          o: "/locations"
          q: {
            exist: [
              "query"
              "type"
              "x"
              "y"
            ]
          }
          s: [
            {
